{
    "name": "bmn/schedule-monitoring",
    "description": "Aplikasi Jadwal dan Monitoring Pemeliharaan & Perbaikan BMN berbasis Web (CodeIgniter 4)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "codeigniter4/framework": "^4.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.21",
        "phpunit/phpunit": "^10.0",
        "mikey179/vfsstream": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "files": [
            "app/Common.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php spark serve"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
